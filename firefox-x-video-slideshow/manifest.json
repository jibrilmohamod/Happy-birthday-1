{
  "manifest_version": 3,
  "name": "X Video Slideshow",
  "version": "0.1.0",
  "description": "Browse X videos as a slideshow using X's native player and controls.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_title": "Toggle X Video Slideshow"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-video-slideshow@jibrilmohamod.github.io",
      "strict_min_version": "109.0"
    }
  }
}
