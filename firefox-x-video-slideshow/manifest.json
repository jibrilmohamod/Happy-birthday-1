{
  "manifest_version": 3,
  "name": "X Video Slideshow",
  "version": "0.4.2",
  "description": "Fullscreen X video slideshow for Firefox using X's existing video player controls.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_title": "Start X Video Slideshow"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "x-video-slideshow@jibrilmohamod.github.io",
      "strict_min_version": "109.0"
    }
  }
}
