{
  "manifest_version": 3,
  "name": "X Video Slideshow",
  "version": "0.9.0",
  "description": "Enhanced Firefox port of Twitter Video Slideshow 3.0 with mixed media, social actions, polished controls, and gesture navigation.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Video Slideshow"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": ["overlay.css"],
      "js": ["core.js", "player.js", "controller.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-video-slideshow@jibrilmohamod.github.io",
      "strict_min_version": "109.0"
    }
  }
}